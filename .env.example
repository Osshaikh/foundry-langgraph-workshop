# ─────────────────────────────────────────────────────────────────────────────
# Foundry LangGraph Workshop — environment
# scripts/provision.ps1 writes this file for you. Otherwise copy to `.env`
# and fill in the values from YOUR lab resource group.
# ─────────────────────────────────────────────────────────────────────────────

# Azure scope
AZURE_SUBSCRIPTION_ID=<subscription-id>
AZURE_RESOURCE_GROUP=rg-lgws-<alias>
AZURE_LOCATION=eastus2

# Foundry account + project
FOUNDRY_ACCOUNT_NAME=aif-lgws-<alias>
FOUNDRY_PROJECT_NAME=proj-lgws
FOUNDRY_PROJECT_ENDPOINT=https://aif-lgws-<alias>.services.ai.azure.com/api/projects/proj-lgws
FOUNDRY_PROJECT_RESOURCE_ID=/subscriptions/<subscription-id>/resourceGroups/rg-lgws-<alias>/providers/Microsoft.CognitiveServices/accounts/aif-lgws-<alias>/projects/proj-lgws

# Model deployments (names created by scripts/provision.ps1)
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-5.4-mini
AZURE_AI_REASONING_DEPLOYMENT_NAME=gpt-5.4
AZURE_AI_EMBEDDING_DEPLOYMENT_NAME=text-embedding-3-large
AZURE_AI_FINETUNE_BASE_MODEL=gpt-4.1-mini

# Azure AI Search (M4, M15)
AZURE_SEARCH_ENDPOINT=https://srch-lgws-<alias>.search.windows.net
AZURE_SEARCH_CONNECTION_NAME=srch-lgws-<alias>

# Observability (M10) — Application Insights connected to the project
APPLICATIONINSIGHTS_CONNECTION_STRING=<app-insights-connection-string>

# Guardrails (M11)
RAI_POLICY_NAME=lgws-strict

# Prefix for every agent / toolbox / index the labs create
LAB_PREFIX=lgws

# Uncomment on Azure VMs / Arc-enabled lab machines so local code uses your `az login`
# instead of the machine's managed identity (hosted agents are not affected).
# AZURE_TOKEN_CREDENTIALS=dev
